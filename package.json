{
  "scripts": {
    "db:setup": "npm run db:clear",
    "db:clear": "npm --prefix src/server run db:clear",
    "db:seed": "npm --prefix src/server run db:seed",
    "test": "npm run test:client && npm run test:server",
    "test:coverage": "npm run test:coverage:client && npm run test:coverage:server",
    "test:client": "npm --prefix src/client test",
    "test:server": "npm --prefix src/server test",
    "test:coverage:client": "npm --prefix src/client run test:coverage",
    "test:coverage:server": "npm --prefix src/server run test:coverage"
  }
}
